# Copy to `.env` and edit before `docker compose up`

# REQUIRED — random 32+ char string. Gates /dashboard, /budgets, /keys, admin endpoints.
SYNOI_ADMIN_KEY=change-me-please-32-chars-or-longer

# OPTIONAL — upstream provider keys (only needed if your tool isn't passing
# its own key in x-api-key or Authorization headers). When set, the gateway
# uses them as a fallback for tenants that don't have their own configured.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...   # required for the Groq arbitrage tier

# OPTIONAL — Ed25519 signing key for Decision Receipts. If unset, the gateway
# generates an ephemeral key on startup and receipts won't survive restart.
# Generate with: openssl genpkey -algorithm ED25519 -out priv.pem
#               openssl pkey -in priv.pem -pubout -out pub.pem
# SYNOI_SIGNING_KEY_PRIVATE=
# SYNOI_SIGNING_KEY_PUBLIC=

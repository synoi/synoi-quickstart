# SynOI Gateway environment — generated by `npx @synoi/start init`.
#
# Keep this file private (mode 0600). The admin key below grants full
# control over the gateway's /keys, /receipts, and /metrics routes.

# ── Required ────────────────────────────────────────────────────────────────
SYNOI_ADMIN_KEY={{ADMIN_KEY}}

# ── License (Personal / Team / Enterprise) ──────────────────────────────────
# Get one at https://app.synoi.systems. Leave blank for free-tier features.
# SYNOI_LICENSE_KEY=

# ── Hosted mode ─────────────────────────────────────────────────────────────
# Set to 1 in any shared deployment to refuse OAuth-mode requests
# (subscription users running their own machine should leave this OFF).
SYNOI_HOSTED_MODE=0

# ── First-run banner ────────────────────────────────────────────────────────
# Suppresses the Vault key generation banner after you've handled the backup.
SYNOI_QUIET_FIRST_RUN=1

# ── Optional features ───────────────────────────────────────────────────────
SYNOI_SHRINK_ENABLE=1
SYNOI_KB_ENABLE=0
SYNOI_HOUSE_STYLE_ENABLE=0
SYNOI_ARBITRAGE_ENABLE=0

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10

# ── Provider routing ────────────────────────────────────────────────────────
# Uncomment to enable arbitrage to Groq for simple queries:
# GROQ_API_KEY=

# ── Receipt signing keys ────────────────────────────────────────────────────
# Generate with:
#   openssl genpkey -algorithm ED25519 -out ed25519.pem
#   openssl pkey -in ed25519.pem -pubout -out ed25519.pub.pem
# Leave blank to use an ephemeral dev key (regenerated each start, warns loud).
# SYNOI_SIGNING_KEY_PRIVATE=
# SYNOI_SIGNING_KEY_PUBLIC=
